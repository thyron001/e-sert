<?xml version="1.0" encoding="UTF-8"?>
<!-- Escenario base_s2: semilla 2, 0 % de buscadores con app (generar_escenarios.py) -->
<configuration>
    <input>
        <net-file value="../red/centro.net.xml"/>
        <route-files value="base_s2.rou.xml"/>
        <additional-files value="../red/centro.poly.xml,../parqueos/parqueos.add.xml,../demanda/rerouters.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="4500"/>
    </time>
    <output>
        <tripinfo-output value="../salidas/base_s2/tripinfo.xml"/>
        <stop-output value="../salidas/base_s2/stops.xml"/>
        <stop-output.write-unfinished value="true"/>
        <vehroute-output value="../salidas/base_s2/vehroutes.xml"/>
        <vehroute-output.exit-times value="true"/>
        <vehroute-output.route-length value="true"/>
        <vehroute-output.write-unfinished value="true"/>
        <emission-output value="../salidas/base_s2/emisiones.xml"/>
        <statistic-output value="../salidas/base_s2/estadisticas.xml"/>
    </output>
    <emissions>
        <device.emissions.probability value="1"/>
        <device.emissions.period value="10"/>
    </emissions>
    <processing>
        <time-to-teleport value="300"/>
        <ignore-route-errors value="true"/>
    </processing>
    <random_number>
        <seed value="2"/>
    </random_number>
    <report>
        <no-step-log value="true"/>
        <duration-log.statistics value="true"/>
    </report>
</configuration>
