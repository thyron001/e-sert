<?xml version="1.0" encoding="UTF-8"?>
<!-- Sintético con formato de la opción vehroute-output de SUMO (con exitTimes). -->
<routes>
    <!-- v1: entra al edge objetivo eObj en t=10 y estaciona en t=15 sin salir del edge. -->
    <vehicle id="v1" depart="0.00" arrival="60.00">
        <route edges="e0 eObj" exitTimes="10.00 60.00"/>
        <stop parkingArea="pa1" duration="40.00"/>
    </vehicle>
    <!-- v2: vuelta de tres edges; el último e1 no tiene tiempo de salida (sigue estacionado). -->
    <vehicle id="v2" depart="90.00">
        <routeDistribution>
            <route replacedOnEdge="e0" replacedAtTime="95.00" probability="0" edges="e0 e9"/>
            <route edges="e0 e1 e2 e3 e1"/>
        </routeDistribution>
        <route edges="e0 e1 e2 e3 e1" exitTimes="100.00 110.00 120.00 130.00"/>
        <stop parkingArea="pa2" duration="100.00"/>
    </vehicle>
</routes>
