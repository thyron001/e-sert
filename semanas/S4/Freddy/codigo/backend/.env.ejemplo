# Copia este archivo como .env (ignorado por git) y rellena los valores. Nunca subas valores reales.
# Base de datos (en el VPS: sqlite:////data/esert.db con el volumen /data)
ESERT_DB_URL=
# Token del controlador TraCI para las rutas 🔒 (/sim/paso, /interno/snapshot, /sesiones/{id}/transicion)
ESERT_TOKEN_SIM=
# Orígenes CORS separados por coma (por defecto *)
ESERT_CORS_ORIGENES=
# Opcionales: CSV de puestos y carpeta del visor (por defecto se detectan solos)
ESERT_PUESTOS_CSV=
ESERT_VISOR_DIR=
