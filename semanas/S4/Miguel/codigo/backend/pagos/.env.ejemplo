# Copia este archivo a backend/pagos/.env (ignorado por git) y completa los valores.
# Las credenciales de prueba de Payphone las tiene Tyrone: nunca van en el repo ni en el chat.

# mock: página local con "Aprobar"/"Rechazar", sin Payphone. pruebas: Payphone en modo de pruebas.
PAYPHONE_MODO=mock
# Token de la aplicación de Payphone Developer (tipo WEB, ambiente de pruebas).
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
# Vacío = https://pay.payphonetodoesposible.com (la misma URL en pruebas y producción).
PAYPHONE_URL_BASE=
# Vacío = ${ESERT_URL_PUBLICA}/api/v1/pagos/retorno. Debe coincidir con la "URL de Respuesta"
# registrada en Payphone Developer.
PAYPHONE_RESPONSE_URL=
# URL pública del backend (sin /api/v1). En el VPS: https://demo.e-sert.tesisucuenca.com.
# En local, la IP de la computadora en la red del teléfono, p. ej. http://192.168.3.168:8000
ESERT_URL_PUBLICA=
