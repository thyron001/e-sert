# Copia este archivo a backend/asistente/.env (ignorado por git) y pon tu clave de la API de
# Anthropic. Sin clave, el asistente usa el intérprete por reglas: la app sigue funcionando.
ANTHROPIC_API_KEY=
# Opcional: otro modelo (por defecto claude-haiku-5-5). Debe aceptar tool_choice forzado: Claude Opus 5.5
# y Claude Sonnet 5.5 responden 400 y el asistente caería siempre a las reglas.
ASISTENTE_MODELO=
# Opcional: ruta a destinos.csv (por defecto se busca proyecto/sumo/demanda/destinos.csv).
ESERT_DESTINOS_CSV=
