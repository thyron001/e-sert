# Copia este archivo a .env (no se sube al repo) y ajusta la IP de la computadora que corre el backend.
# En el teléfono nunca uses localhost: sería el propio teléfono.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api/v1
# 1 = cliente mock en memoria (sin backend); 0 = backend real. Luego se puede cambiar en Ajustes.
EXPO_PUBLIC_USE_MOCK=1

# Opcional: servidor solo para el modo espejo (p. ej. el mock de mock_espejo/ en el puerto 8001).
# Sin la variable, el espejo usa la misma URL de la API.
EXPO_PUBLIC_ESPEJO_URL=

# Modo demo (S3-2): 60 = un minuto de las reglas de avisos dura un segundo. Sin la variable, 1.
EXPO_PUBLIC_ESCALA_TIEMPO=

# Opcional (S3-3): servidor del asistente de entrada natural, p. ej. app_dev.py en el puerto 8002.
# Sin la variable se usa la URL de la API (cuando Freddy monte el router).
EXPO_PUBLIC_ASISTENTE_URL=
